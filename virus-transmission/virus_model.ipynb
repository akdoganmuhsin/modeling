import matplotlib.pyplot as plt
import numpy as np
from scipy.integrate import solve_ivp


def virus_transmission_model(t, y, beta, gamma, mu, nu ,p):
  S, I, R = y
  N = S + I + R


  #Differential Equations
  dSdt = nu * (S + R) + nu * (1-p) * I - beta * S * I - mu * S
  dIdt = beta * S * I + nu * p * I - gamma * I - mu *I
  dRdt = gamma * I - mu * R

  return [dSdt, dIdt, dRdt]


#Parameters

beta = 0.3  #horizontal transmission rate
gamma = 0.1 #recovery rate
mu = 0.01 #natural death ratio
nu = 0.015 #birth rate
p = 0.4 #vertical transmission rate


# Initial Conditions (S0, I0, R0)
y0 = [0.99, 0.01, 0.0]
t_span = (0, 160)
t_eval = np.linspace(0, 160, 1000)

#Solution

sol = solve_ivp(
  virus_transmission_model,
  t_span,
  y0,
  args=(beta, gamma, mu, nu, p),
  t_eval=t_eval,
)

#Visualising Systems
plt.figure(figsize=(10, 5))
plt.plot(sol.t, sol.y[0], label="Sensitive (S)", color="blue")
plt.plot(sol.t, sol.y[1], label="Infected (I)", color="red")
plt.plot(sol.t, sol.y[2], label="Recovered (R)", color="green")
plt.title("Vertical and Horizontal Transmission Included Transmisson Disease Dynamics")
plt.xlabel("Time(day)")
plt.ylabel("Population Rate")
plt.grid(True, linestyle="--", alpha=0.6)
plt.legend()
plt.show()










